# Futu OpenD Connection
OPEND_IP=host.docker.internal
OPEND_PORT=11111
OPEND_ENCRYPT=false
# OPEND_RSA_KEY=

# Stock Group Filter (leave empty to use first group)
FUTU_GROUP_NAME=关注

# Monitoring Parameters
PRICE_CHANGE_THRESHOLD=3.0
ALERT_COOLDOWN_MINUTES=3
KLINE_REFRESH_INTERVAL=60000
MARKET_STATE_POLL_INTERVAL=30000

# MA Periods (comma-separated)
# Default: 5,13,30,55

# Reconnect Settings
RECONNECT_INITIAL_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000
RECONNECT_MULTIPLIER=2.0

# Email Notification
MAIL_ENABLED=true
MAIL_HOST=smtp.126.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
MAIL_TO=

# Docker-specific: use host.docker.internal to reach OpenD on host machine
# OPEND_IP=host.docker.internal

# ============ 大模型供应商（OpenAI 兼容 Chat Completions）============
# 默认供应商 id（定时任务与前端默认选中项）；从 deepseek / glm / kimi 中选一个
AI_DEFAULT_PROVIDER=deepseek

# --- DeepSeek（已配置；AI_DEEPSEEK_* 优先于下面的旧 DEEPSEEK_* 回退）---
AI_DEEPSEEK_LABEL=DeepSeek
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
AI_DEEPSEEK_MODEL=deepseek-chat

# --- Kimi（Moonshot）---
# model id 以 Moonshot 官方文档为准；占位 moonshot-v1-auto。
AI_KIMI_LABEL=Kimi
AI_KIMI_API_KEY=
AI_KIMI_API_URL=https://api.kimi.com/coding/v1/chat/completions
AI_KIMI_MODEL=kimi-k3

# 旧变量保留为回退源（application.yml 里 AI_DEEPSEEK_* 缺失时自动取这组）。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

AI_VISION_LABEL=Vision
AI_VISION_API_KEY=
AI_VISION_API_URL=https://api.kimi.com/coding/v1/chat/completions
AI_VISION_MODEL=kimi-for-coding
AI_VISION_USER_AGENT=claude-code/0.1.0
